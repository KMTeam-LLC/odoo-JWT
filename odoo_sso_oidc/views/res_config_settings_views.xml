<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add OIDC settings to General Settings -->
    <record id="view_general_configuration_oidc" model="ir.ui.view">
        <field name="name">res.config.settings.oidc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="OIDC Authentication" 
                     string="OIDC Authentication" data-key="odoo_sso_oidc">
                    <h2>OIDC Single Sign-On</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">OIDC Providers</span>
                                <div class="text-muted">
                                    Configure Single Sign-On with OIDC providers
                                </div>
                                <div class="mt8">
                                    <button name="%(action_oidc_provider)d" 
                                            icon="fa-arrow-right" 
                                            type="action" 
                                            string="Configure OIDC Providers" 
                                            class="btn-link"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
